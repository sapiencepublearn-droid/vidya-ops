# ---- required ----
DATABASE_URL=postgres://crm_app:CHANGE_ME@db-host:5432/crm      # least-privilege app role
ADMIN_DATABASE_URL=postgres://crm_owner:CHANGE_ME@db-host:5432/crm  # migrations + backups only
JWT_SECRET=                       # openssl rand -hex 32 ; min 32 chars, never in git
FILE_SECRET=                      # separate secret for download link signing

# ---- required in production ----
NODE_ENV=production
CORS_ORIGINS=https://crm.vidyapub.in       # explicit allowlist, never *

# ---- tuning (defaults shown) ----
PORT=3000
TOKEN_TTL_MINUTES=720
LOGIN_RATE_MAX=10
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
MAX_UPLOAD_BYTES=10485760
MAX_ACCURACY_M=100
GPS_RETENTION_DAYS=90
STATEMENT_TIMEOUT_MS=5000
STORAGE_DIR=/var/lib/crm/storage
LOG_LEVEL=info

# ---- backups ----
BACKUP_DIR=/var/backups/crm
BACKUP_RETAIN_DAYS=30
# BACKUP_GPG_RECIPIENT=ops@vidyapub.in
# BACKUP_S3_URI=s3://vidyapub-backups/crm
